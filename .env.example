# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=*

# DynamoDB Local
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_DEFAULT_REGION=us-east-1
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
